config ani-rss 'main'
	option enabled '0'
	option port '7789'
	option bind_addr '0.0.0.0'
	option config_dir '/etc/ani-rss'
	option download_dir '/mnt/sda1/anime'
	option java_path ''
	option jar_path ''
	option heap_min '32M'
	option heap_max '256M'
	option jvm_options '-XX:+UseG1GC -Xss256k'
	option mirror_source 'ghfast'
	option custom_mirror ''
