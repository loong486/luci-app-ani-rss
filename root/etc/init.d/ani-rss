#!/bin/sh /etc/rc.common
# Copyright (C) 2026 OpenWrt / ImmortalWrt Community

START=95
STOP=10

USE_PROCD=1
PROG="/usr/bin/ani-rss-helper"
LOG_FILE="/var/log/ani-rss.log"
PID_FILE="/var/run/ani-rss.pid"

start_service() {
	local enabled port bind_addr config_dir download_dir
	local java_path jar_path heap_min heap_max jvm_options

	config_load ani-rss
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get port main port "7789"
	config_get bind_addr main bind_addr "0.0.0.0"
	config_get config_dir main config_dir "/etc/ani-rss"
	config_get download_dir main download_dir "/mnt/sda1/anime"
	config_get java_path main java_path ""
	config_get jar_path main jar_path ""
	config_get heap_min main heap_min "32M"
	config_get heap_max main heap_max "256M"
	config_get jvm_options main jvm_options "-XX:+UseG1GC -Xss256k"

	mkdir -p "$config_dir"
	[ -n "$download_dir" ] && mkdir -p "$download_dir"

	# Resolve Java binary
	local java_bin="$java_path"
	if [ -z "$java_bin" ] || [ ! -x "$java_bin" ]; then
		java_bin=$($PROG find_java 2>/dev/null)
	fi

	if [ -z "$java_bin" ] || [ ! -x "$java_bin" ]; then
		echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: Java runtime not found! Please install OpenJDK or click 'Install JRE' in LuCI." >> "$LOG_FILE"
		logger -t ani-rss "ERROR: Java runtime not found. Aborting startup."
		return 1
	fi

	# Resolve ani-rss.jar
	local jar_file="$jar_path"
	if [ -z "$jar_file" ] || [ ! -f "$jar_file" ]; then
		jar_file=$($PROG find_jar 2>/dev/null)
	fi

	if [ -z "$jar_file" ] || [ ! -f "$jar_file" ]; then
		echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: ani-rss.jar not found at '$jar_file'! Please click 'Download Core' in LuCI." >> "$LOG_FILE"
		logger -t ani-rss "ERROR: ani-rss.jar not found. Aborting startup."
		return 1
	fi

	echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting ANI-RSS service on port $port..." >> "$LOG_FILE"
	echo "  Java: $java_bin" >> "$LOG_FILE"
	echo "  JAR:  $jar_file" >> "$LOG_FILE"
	echo "  Data: $config_dir" >> "$LOG_FILE"
	echo "  Heap: -Xms$heap_min -Xmx$heap_max" >> "$LOG_FILE"

	local tz="$(cat /etc/timezone 2>/dev/null)"
	[ -z "$tz" ] && tz="Asia/Shanghai"

	procd_open_instance "ani-rss"
	procd_set_param command "$java_bin" \
		"-Xms$heap_min" \
		"-Xmx$heap_max" \
		$jvm_options \
		"-Dserver.port=$port" \
		"-Dserver.address=$bind_addr" \
		"-Duser.timezone=$tz" \
		"-jar" "$jar_file"

	procd_set_param env SERVER_PORT="$port" CONFIG="$config_dir" TZ="$tz"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/ani-rss
	procd_set_param pidfile "$PID_FILE"
	procd_close_instance

	logger -t ani-rss "ANI-RSS daemon started on port $port."
}

stop_service() {
	logger -t ani-rss "Stopping ANI-RSS service..."
	echo "[$(date '+%Y-%m-%d %H:%M:%S')] Stopping ANI-RSS service..." >> "$LOG_FILE"
	local pid=$(pgrep -f "ani-rss.jar" 2>/dev/null)
	if [ -n "$pid" ]; then
		kill "$pid" 2>/dev/null
		sleep 1
		kill -9 "$pid" 2>/dev/null || true
	fi
	rm -f "$PID_FILE"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "ani-rss"
}
